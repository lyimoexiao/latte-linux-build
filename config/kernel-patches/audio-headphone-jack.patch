diff --git a/sound/soc/intel/boards/cht_bsw_rt5659.c b/sound/soc/intel/boards/cht_bsw_rt5659.c
index 615466033..2406869bd 100644
--- a/sound/soc/intel/boards/cht_bsw_rt5659.c
+++ b/sound/soc/intel/boards/cht_bsw_rt5659.c
@@ -389,6 +389,22 @@ static int cht_audio_init(struct snd_soc_pcm_runtime *runtime)
 	snd_soc_dapm_enable_pin(&card->dapm, "Ext Spk");
 	snd_soc_dapm_enable_pin(&card->dapm, "Int Mic");
 
+	/* 启用 rt5659 耳机插拔检测（JD3 内部检测，rt5659 驱动轮询上报） */
+	ret = snd_soc_card_jack_new_pins(card, "Headset",
+					 SND_JACK_HEADSET | SND_JACK_BTN_0 |
+					 SND_JACK_BTN_1 | SND_JACK_BTN_2,
+					 &ctx->headset,
+					 cht_bsw_headset_pins,
+					 ARRAY_SIZE(cht_bsw_headset_pins));
+	if (ret)
+		return ret;
+
+	snd_jack_set_key(ctx->headset.jack, SND_JACK_BTN_0, KEY_PLAYPAUSE);
+	snd_jack_set_key(ctx->headset.jack, SND_JACK_BTN_1, KEY_VOLUMEUP);
+	snd_jack_set_key(ctx->headset.jack, SND_JACK_BTN_2, KEY_VOLUMEDOWN);
+
+	rt5659_set_jack_detect(component, &ctx->headset);
+
 	snd_soc_dapm_sync(&card->dapm);
 	return ret;
 }
