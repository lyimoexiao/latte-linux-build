diff --git a/sound/soc/codecs/rt5659.c b/sound/soc/codecs/rt5659.c
index 48ae2a6bf..fbc662450 100644
--- a/sound/soc/codecs/rt5659.c
+++ b/sound/soc/codecs/rt5659.c
@@ -1370,6 +1370,9 @@ static void rt5659_jack_detect_work(struct work_struct *work)
 	if (!rt5659->component)
 		return;
 
+	if (!rt5659->hs_jack)
+		return;
+
 	val = snd_soc_component_read(rt5659->component, RT5659_INT_ST_1) & 0x0080;
 	if (!val) {
 		/* jack in */
@@ -1430,6 +1433,10 @@ static void rt5659_jack_detect_work(struct work_struct *work)
 	snd_soc_jack_report(rt5659->hs_jack, report, SND_JACK_HEADSET |
 			    SND_JACK_BTN_0 | SND_JACK_BTN_1 |
 			    SND_JACK_BTN_2 | SND_JACK_BTN_3);
+
+	/* 轮询模式：不依赖 IRQ，周期检测插拔状态 */
+	queue_delayed_work(system_power_efficient_wq,
+			   &rt5659->jack_detect_work, msecs_to_jiffies(1000));
 }
 
 static void rt5659_jack_detect_intel_hd_header(struct work_struct *work)
@@ -3849,6 +3856,10 @@ static int rt5659_parse_dt(struct rt5659_priv *rt5659, struct device *dev)
 		&rt5659->pdata.dmic2_data_pin);
 	device_property_read_u32(dev, "realtek,jd-src",
 		&rt5659->pdata.jd_src);
+	/* Xiaomi Mi Pad 2 (latte): 芯片出厂默认已配置 JD3 检测寄存器，
+	 * ACPI 未提供 realtek,jd-src，这里强制启用 JD3 检测。 */
+	if (rt5659->pdata.jd_src == RT5659_JD_NULL)
+		rt5659->pdata.jd_src = RT5659_JD3;
 
 	return 0;
 }
